# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API_PORT: Express backend server port for local development.
API_PORT="8787"

# PORT: Production runtime port (used when NODE_ENV=production).
PORT="8787"

# VITE_API_BASE_URL: Set only when frontend and backend are hosted on different origins.
# Leave empty for same-origin deployments.
VITE_API_BASE_URL=""

# VITE_API_PROXY_TARGET: Vite dev proxy target for /api requests.
VITE_API_PROXY_TARGET="http://localhost:8787"

# REDIS_URL: Redis connection URL for queue and job status storage.
REDIS_URL="redis://127.0.0.1:6379"

# ANALYSIS_WORKER_CONCURRENCY: Number of concurrent analysis jobs processed by worker.
ANALYSIS_WORKER_CONCURRENCY="2"

# ANALYSIS_JOB_ATTEMPTS: Retry count for each queued analysis task.
ANALYSIS_JOB_ATTEMPTS="3"

# ANALYSIS_JOB_BACKOFF_MS: Initial retry backoff delay (exponential).
ANALYSIS_JOB_BACKOFF_MS="1000"

# ANALYSIS_JOB_RESULT_TTL_SEC: Job status/result retention in Redis.
ANALYSIS_JOB_RESULT_TTL_SEC="86400"

# ANALYSIS_DEDUPE_TTL_SEC: Duplicate upload dedupe window.
ANALYSIS_DEDUPE_TTL_SEC="600"
